<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TodoList.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="600"
        d:DesignHeight="720"
        x:Class="TodoList.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Icon="/Assets/avalonia-logo.ico"
        Width="600"
        MinWidth="600"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="True"
        Title="Todo Side Panel">

    <Window.Styles>
        <Style Selector="Border.panelChrome">
            <Setter Property="Background" Value="#202225" />
        </Style>

        <Style Selector="Border.todoListSurface">
            <Setter Property="Background" Value="#2B2F36" />
            <Setter Property="BorderBrush" Value="#4C5460" />
        </Style>

        <Style Selector="ListBox.todoListContent">
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ScrollViewer.todoListContent">
            <Setter Property="Background" Value="#2B2B2B" />
        </Style>

        <Style Selector="TextBlock.summaryText">
            <Setter Property="Foreground" Value="#C4CAD3" />
        </Style>
    </Window.Styles>

    <Border Padding="16" Classes="panelChrome">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="Todos"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <ToggleButton Grid.Column="1"
                              IsChecked="{Binding IsPinned}"
                              Content="Pin"
                              MinWidth="74"
                              HorizontalAlignment="Right"
                              ToolTip.Tip="When pinned, the panel stays open.">
                    <ToggleButton.Styles>
                        <Style Selector="ToggleButton:checked">
                            <Setter Property="Content" Value="Pinned" />
                        </Style>
                    </ToggleButton.Styles>
                </ToggleButton>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding NewTodoText}"
                         Watermark="Add a new task"
                         VerticalContentAlignment="Center">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AddTodoCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1"
                        Content="Add"
                        Padding="14,8"
                        Command="{Binding AddTodoCommand}" />
            </Grid>

            <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="View" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableFilters}"
                              SelectedItem="{Binding SelectedFilter}" />
                    <ComboBox Grid.Column="2"
                              MinWidth="140"
                              ItemsSource="{Binding AvailableGroupingOptions}"
                              SelectedItem="{Binding SelectedGroupingOption}" />
                </Grid>

                <Border Grid.Row="1" Classes="todoListSurface" CornerRadius="8" BorderThickness="1">
                    <Grid RowDefinitions="*">
                        <ListBox Classes="todoListContent" IsVisible="{Binding ShowFlatList}" ItemsSource="{Binding VisibleTodos}" Padding="6">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TodoItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="4">
                                        <CheckBox Grid.Column="0"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,0,0"
                                                  IsChecked="{Binding IsCompleted}"
                                                  Command="{Binding #RootWindow.DataContext.ToggleCompletedCommand}"
                                                  CommandParameter="{Binding}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <Button Grid.Column="2"
                                                VerticalAlignment="Top"
                                                IsVisible="{Binding CanReject}"
                                                Content="Reject"
                                                Command="{Binding #RootWindow.DataContext.RejectTodoCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="3"
                                                VerticalAlignment="Top"
                                                Content="Delete"
                                                Command="{Binding #RootWindow.DataContext.DeleteTodoCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer Classes="todoListContent" IsVisible="{Binding GroupByDayAdded}" Padding="6">
                            <ItemsControl ItemsSource="{Binding VisibleTodoGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TodoDayGroupViewModel">
                                        <StackPanel Margin="0,0,0,10" Spacing="4">
                                            <TextBlock Text="{Binding Header}"
                                                       FontWeight="SemiBold"
                                                       Margin="4,4,4,2" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TodoItemViewModel">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="4">
                                                            <CheckBox Grid.Column="0"
                                                                      VerticalAlignment="Top"
                                                                      Margin="0,2,0,0"
                                                                      IsChecked="{Binding IsCompleted}"
                                                                      Command="{Binding #RootWindow.DataContext.ToggleCompletedCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Title}"
                                                                       VerticalAlignment="Center"
                                                                       TextWrapping="Wrap" />
                                                            <Button Grid.Column="2"
                                                                    VerticalAlignment="Top"
                                                                    IsVisible="{Binding CanReject}"
                                                                    Content="Reject"
                                                                    Command="{Binding #RootWindow.DataContext.RejectTodoCommand}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Grid.Column="3"
                                                                    VerticalAlignment="Top"
                                                                    Content="Delete"
                                                                    Command="{Binding #RootWindow.DataContext.DeleteTodoCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.Row="3"
                       Classes="summaryText"
                       FontSize="12"
                       Text="{Binding SummaryText}" />
        </Grid>
    </Border>

</Window>
