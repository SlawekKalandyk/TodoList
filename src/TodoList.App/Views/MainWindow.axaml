<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TodoList.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="600"
        d:DesignHeight="720"
        x:Class="TodoList.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Icon="/Assets/avalonia-logo.ico"
        Width="600"
        MinWidth="480"
        MaxWidth="1200"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="True"
        Title="Todo Side Panel">

    <Window.Styles>
        <Style Selector="Border.panelChrome">
            <Setter Property="Background" Value="#202225" />
        </Style>

        <Style Selector="Border.todoListSurface">
            <Setter Property="Background" Value="#2B2F36" />
            <Setter Property="BorderBrush" Value="#4C5460" />
        </Style>

        <Style Selector="ScrollViewer.todoListContent">
            <Setter Property="Background" Value="#2B2B2B" />
        </Style>

        <Style Selector="TextBlock.summaryText">
            <Setter Property="Foreground" Value="#C4CAD3" />
        </Style>

        <Style Selector="Grid.todoRow">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.groupedTodoRow">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.groupedTodoRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>

        <Style Selector="Border.groupedTodoRow:pressed">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}" />
        </Style>

        <Style Selector="Border.groupedTodoRow.detailsExpanded">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
        </Style>

        <Style Selector="Border.groupedTodoRow.detailsExpanded:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentMediumBrush}" />
        </Style>

        <Style Selector="Border.groupedTodoRow.detailsExpanded:pressed">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentHighBrush}" />
        </Style>
    </Window.Styles>

    <Border x:Name="PanelRoot" Padding="16" Classes="panelChrome" Focusable="True">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="Todos"
                           FontSize="24"
                           FontWeight="SemiBold" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Panel width in percent (100% = 600px)">
                    <NumericUpDown x:Name="WidthPercentInput"
                                   Width="124"
                                   Minimum="80"
                                   Maximum="200"
                                   Increment="5"
                                   FormatString="N0"
                                   HorizontalContentAlignment="Center"
                                   Value="{Binding #RootWindow.WidthPercentEditorValue, Mode=TwoWay}"
                                   LostFocus="WidthPercentInput_OnLostFocus" />
                    <TextBlock VerticalAlignment="Center" Text="%" />
                </StackPanel>
                <ToggleButton Grid.Column="2"
                              IsChecked="{Binding IsPinned}"
                              Content="Pin"
                              MinWidth="74"
                              HorizontalAlignment="Right"
                              ToolTip.Tip="When pinned, the panel stays open.">
                    <ToggleButton.Styles>
                        <Style Selector="ToggleButton:checked">
                            <Setter Property="Content" Value="Pinned" />
                        </Style>
                    </ToggleButton.Styles>
                </ToggleButton>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding NewTodoText}"
                         Watermark="Add a new task"
                         VerticalContentAlignment="Center">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AddTodoCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <ComboBox Grid.Column="1"
                          MinWidth="108"
                          ItemsSource="{Binding AvailablePriorities}"
                          SelectedItem="{Binding NewTodoPriority}" />
                <Button Grid.Column="2"
                        Content="Add"
                        Padding="14,8"
                        Command="{Binding AddTodoCommand}" />
            </Grid>

            <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                <StackPanel Grid.Row="0" Spacing="6">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="8"
                          RowSpacing="4">
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Text="Filters"
                                   FontSize="11"
                                   Opacity="0.85" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="3"
                                   Text="Group By"
                                   FontSize="11"
                                   Opacity="0.85" />

                        <ComboBox Grid.Row="1"
                                  Grid.Column="0"
                                  MinWidth="120"
                                  ItemsSource="{Binding AvailableFilters}"
                                  SelectedItem="{Binding SelectedFilter}" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  MinWidth="120"
                                  ItemsSource="{Binding AvailablePriorityFilters}"
                                  SelectedItem="{Binding SelectedPriorityFilter}" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="3"
                                  MinWidth="140"
                                  MaxWidth="180"
                                  ItemsSource="{Binding AvailableGroupingOptions}"
                                  SelectedItem="{Binding SelectedGroupingOption}" />
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,Auto,*"
                                                    RowDefinitions="Auto,Auto"
                                                    ColumnSpacing="8"
                                                    RowSpacing="4">
                                                <TextBlock Grid.Row="0"
                                                                     Grid.Column="0"
                                                                     Text="Order By"
                                                                     FontSize="11"
                                                                     Opacity="0.85" />
                                                <TextBlock Grid.Row="0"
                                                                     Grid.Column="1"
                                                                     Text="Direction"
                                                                     FontSize="11"
                                                                     Opacity="0.85" />

                                                <ComboBox Grid.Row="1"
                                                                    Grid.Column="0"
                                                                    MinWidth="140"
                                                                    MaxWidth="180"
                                                                    ItemsSource="{Binding AvailableOrderingOptions}"
                                                                    SelectedItem="{Binding SelectedOrderingOption}" />
                                                <ComboBox Grid.Row="1"
                                                                    Grid.Column="1"
                                                                    MinWidth="140"
                                                                    MaxWidth="180"
                                                                    ItemsSource="{Binding AvailableOrderingDirections}"
                                                                    SelectedItem="{Binding SelectedOrderingDirection}" />
                                        </Grid>
                </StackPanel>

                <Border Grid.Row="1" Classes="todoListSurface" CornerRadius="8" BorderThickness="1">
                    <Grid RowDefinitions="*">
                        <ScrollViewer Classes="todoListContent" IsVisible="{Binding ShowFlatList}" Padding="6">
                            <ItemsControl ItemsSource="{Binding VisibleTodos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TodoItemViewModel">
                                        <Border Classes="todoRow groupedTodoRow"
                                                Classes.detailsExpanded="{Binding IsDetailsExpanded}"
                                                HorizontalAlignment="Stretch"
                                                Margin="4"
                                                Padding="12,9,12,12"
                                                Tapped="TodoItemRow_OnTapped"
                                                DoubleTapped="TodoItemRow_OnDoubleTapped">
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  RowDefinitions="Auto,Auto"
                                                  ColumnSpacing="8"
                                                  RowSpacing="6">
                                                <CheckBox Grid.Column="0"
                                                          VerticalAlignment="Top"
                                                          Margin="0,2,0,0"
                                                          IsChecked="{Binding IsCompleted}"
                                                          IsEnabled="{Binding CanToggleCompleted}"
                                                          Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).ToggleCompletedCommand}"
                                                          CommandParameter="{Binding}" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <StackPanel IsVisible="{Binding IsNotRenaming}" Spacing="2">
                                                        <TextBlock Text="{Binding Title}"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding PriorityLabel}"
                                                                   Opacity="0.75"
                                                                   FontSize="11" />
                                                        <TextBlock Text="{Binding DueDateLabel}"
                                                                   IsVisible="{Binding HasDueDate}"
                                                                   Opacity="0.75"
                                                                   FontSize="11" />
                                                    </StackPanel>
                                                    <TextBox IsVisible="{Binding IsRenaming}"
                                                             Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             LostFocus="TodoRenameTextBox_OnLostFocus">
                                                        <TextBox.KeyBindings>
                                                            <KeyBinding Gesture="Enter"
                                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).CommitRenameTodoCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            <KeyBinding Gesture="Escape"
                                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).CancelRenameTodoCommand}"
                                                                        CommandParameter="{Binding}" />
                                                        </TextBox.KeyBindings>
                                                    </TextBox>
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        VerticalAlignment="Top"
                                                        IsVisible="{Binding CanReject}"
                                                        Content="Reject"
                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).RejectTodoCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Grid.Column="2"
                                                        VerticalAlignment="Top"
                                                        IsVisible="{Binding IsRejected}"
                                                        Content="Restore"
                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).RestoreTodoCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Border Classes="todoDetailsPanel"
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Grid.ColumnSpan="2"
                                                        IsVisible="{Binding IsDetailsExpanded}"
                                                        CornerRadius="6"
                                                        BorderThickness="1"
                                                        BorderBrush="#4C5460"
                                                        Background="#23262C"
                                                        Padding="8">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="Priority"
                                                                   FontSize="11"
                                                                   Opacity="0.8" />
                                                        <ComboBox MinWidth="132"
                                                                  ItemsSource="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).AvailablePriorities}"
                                                                  SelectedItem="{Binding Priority}"
                                                                  DropDownOpened="TodoPriorityComboBox_OnDropDownOpened"
                                                                  DropDownClosed="TodoPriorityComboBox_OnDropDownClosed"
                                                                  SelectionChanged="TodoPriorityComboBox_OnSelectionChanged" />
                                                        <TextBlock Text="Due date"
                                                                   FontSize="11"
                                                                   Opacity="0.8" />
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                            <DatePicker Grid.Column="0"
                                                                        MinWidth="0"
                                                                        HorizontalAlignment="Stretch"
                                                                        MonthFormat="MMM"
                                                                        SelectedDate="{Binding DueAtUtc, Mode=TwoWay}"
                                                                        SelectedDateChanged="TodoDueDatePicker_OnSelectedDateChanged"
                                                                        LostFocus="TodoDueDatePicker_OnLostFocus" />
                                                            <Button Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Width="32"
                                                                    Height="32"
                                                                    MinWidth="32"
                                                                    MinHeight="32"
                                                                    Padding="0"
                                                                    ToolTip.Tip="Clear due date"
                                                                    Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).ClearTodoDueAtUtcCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Path Width="12"
                                                                      Height="12"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Stretch="Uniform"
                                                                      Fill="#C4CAD3"
                                                                      Data="M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M19,4H15.5L14.79,3.29C14.61,3.11 14.36,3 14.1,3H9.89C9.63,3 9.38,3.11 9.2,3.29L8.5,4H5V6H19V4Z" />
                                                            </Button>
                                                        </Grid>
                                                        <TextBlock Text="Notes"
                                                                   FontSize="11"
                                                                   Opacity="0.8" />
                                                        <TextBox MinHeight="72"
                                                                 TextWrapping="Wrap"
                                                                 AcceptsReturn="True"
                                                                 VerticalContentAlignment="Top"
                                                                 Watermark="Add notes..."
                                                                 Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 LostFocus="TodoNotesTextBox_OnLostFocus" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ScrollViewer Classes="todoListContent" IsVisible="{Binding ShowGroupedList}" Padding="6">
                            <ItemsControl ItemsSource="{Binding VisibleTodoGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TodoDayGroupViewModel">
                                        <StackPanel Margin="0,0,0,10" Spacing="4">
                                            <TextBlock Text="{Binding Header}"
                                                       FontWeight="SemiBold"
                                                       Margin="4,4,4,2" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TodoItemViewModel">
                                                        <Border Classes="todoRow groupedTodoRow"
                                                                Classes.detailsExpanded="{Binding IsDetailsExpanded}"
                                                            HorizontalAlignment="Stretch"
                                                                Margin="4"
                                                                Padding="12,9,12,12"
                                                                Tapped="TodoItemRow_OnTapped"
                                                                DoubleTapped="TodoItemRow_OnDoubleTapped">
                                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                                  RowDefinitions="Auto,Auto"
                                                                  ColumnSpacing="8"
                                                                  RowSpacing="6">
                                                                <CheckBox Grid.Column="0"
                                                                          VerticalAlignment="Top"
                                                                          Margin="0,2,0,0"
                                                                          IsChecked="{Binding IsCompleted}"
                                                                          IsEnabled="{Binding CanToggleCompleted}"
                                                                          Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).ToggleCompletedCommand}"
                                                                          CommandParameter="{Binding}" />
                                                                <StackPanel Grid.Column="1" Spacing="2">
                                                                    <StackPanel IsVisible="{Binding IsNotRenaming}" Spacing="2">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   VerticalAlignment="Center"
                                                                                   TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding PriorityLabel}"
                                                                                   Opacity="0.75"
                                                                                   FontSize="11" />
                                                                        <TextBlock Text="{Binding DueDateLabel}"
                                                                                   IsVisible="{Binding HasDueDate}"
                                                                                   Opacity="0.75"
                                                                                   FontSize="11" />
                                                                    </StackPanel>
                                                                    <TextBox IsVisible="{Binding IsRenaming}"
                                                                             Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             LostFocus="TodoRenameTextBox_OnLostFocus">
                                                                        <TextBox.KeyBindings>
                                                                            <KeyBinding Gesture="Enter"
                                                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).CommitRenameTodoCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                            <KeyBinding Gesture="Escape"
                                                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).CancelRenameTodoCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                        </TextBox.KeyBindings>
                                                                    </TextBox>
                                                                </StackPanel>
                                                                <Button Grid.Column="2"
                                                                        VerticalAlignment="Top"
                                                                        IsVisible="{Binding CanReject}"
                                                                        Content="Reject"
                                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).RejectTodoCommand}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Grid.Column="2"
                                                                        VerticalAlignment="Top"
                                                                        IsVisible="{Binding IsRejected}"
                                                                        Content="Restore"
                                                                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).RestoreTodoCommand}"
                                                                        CommandParameter="{Binding}" />
                                                                <Border Classes="todoDetailsPanel"
                                                                        Grid.Row="1"
                                                                        Grid.Column="1"
                                                                        Grid.ColumnSpan="2"
                                                                        IsVisible="{Binding IsDetailsExpanded}"
                                                                        CornerRadius="6"
                                                                        BorderThickness="1"
                                                                        BorderBrush="#4C5460"
                                                                        Background="#23262C"
                                                                        Padding="8">
                                                                    <StackPanel Spacing="6">
                                                                        <TextBlock Text="Priority"
                                                                                   FontSize="11"
                                                                                   Opacity="0.8" />
                                                                        <ComboBox MinWidth="132"
                                                                                  ItemsSource="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).AvailablePriorities}"
                                                                                  SelectedItem="{Binding Priority}"
                                                                                  DropDownOpened="TodoPriorityComboBox_OnDropDownOpened"
                                                                                  DropDownClosed="TodoPriorityComboBox_OnDropDownClosed"
                                                                                  SelectionChanged="TodoPriorityComboBox_OnSelectionChanged" />
                                                                        <TextBlock Text="Due date"
                                                                                   FontSize="11"
                                                                                   Opacity="0.8" />
                                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                                            <DatePicker Grid.Column="0"
                                                                                        MinWidth="0"
                                                                                        HorizontalAlignment="Stretch"
                                                                                        MonthFormat="MMM"
                                                                                        SelectedDate="{Binding DueAtUtc, Mode=TwoWay}"
                                                                                        SelectedDateChanged="TodoDueDatePicker_OnSelectedDateChanged"
                                                                                        LostFocus="TodoDueDatePicker_OnLostFocus" />
                                                                            <Button Grid.Column="1"
                                                                                    VerticalAlignment="Center"
                                                                                    Width="32"
                                                                                    Height="32"
                                                                                    MinWidth="32"
                                                                                    MinHeight="32"
                                                                                    Padding="0"
                                                                                    ToolTip.Tip="Clear due date"
                                                                                    Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).ClearTodoDueAtUtcCommand}"
                                                                                    CommandParameter="{Binding}">
                                                                                <Path Width="12"
                                                                                      Height="12"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Stretch="Uniform"
                                                                                      Fill="#C4CAD3"
                                                                                      Data="M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M19,4H15.5L14.79,3.29C14.61,3.11 14.36,3 14.1,3H9.89C9.63,3 9.38,3.11 9.2,3.29L8.5,4H5V6H19V4Z" />
                                                                            </Button>
                                                                        </Grid>
                                                                        <TextBlock Text="Notes"
                                                                                   FontSize="11"
                                                                                   Opacity="0.8" />
                                                                        <TextBox MinHeight="72"
                                                                                 TextWrapping="Wrap"
                                                                                 AcceptsReturn="True"
                                                                                 VerticalContentAlignment="Top"
                                                                                 Watermark="Add notes..."
                                                                                 Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 LostFocus="TodoNotesTextBox_OnLostFocus" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.Row="3"
                       Classes="summaryText"
                       FontSize="12"
                       Text="{Binding SummaryText}" />
        </Grid>
    </Border>

</Window>
